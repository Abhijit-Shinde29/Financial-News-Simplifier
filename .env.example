# OpenAI API Configuration
# Replace with your actual OpenAI API key (starts with sk-...)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model configuration (e.g., gpt-4o-mini, gpt-4o, gpt-3.5-turbo)
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (SQLite default)
DATABASE_URL=sqlite:///data/news_history.db

# Optional Settings
# Maximum character count for analyzed articles to prevent token overruns
MAX_ARTICLE_CHARS=25000
# Minimum character count required for analysis
MIN_ARTICLE_CHARS=60
